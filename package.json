{
  "name": "@cic-it-nancy/dicom-brush",
  "version": "2.0.0-alpha.0",
  "description": "A TypeScript/JavaScript library for manipulating DICOM images, enabling redaction (masking) of image regions, metadata extraction, and transfer syntax transcoding.",
  "license": "LGPL-3.0",
  "author": "CIC-IT Nancy",
  "repository": "https://github.com/CIC-IT-Nancy/dicom-brush",
  "bugs": "https://github.com/CIC-IT-Nancy/dicom-brush/issues",
  "contributors": [
    {
      "name": "Pierre 'AlasDiablo' M",
      "url": "https://github.com/AlasDiablo"
    }
  ],
  "scripts": {
    "build:esm": "tsc -p tsconfig.esm.json && tsc-alias -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && tsc-alias -p tsconfig.cjs.json",
    "build": "npm run build:esm && npm run build:cjs",
    "prepublish": "npm run build"
  },
  "type": "module",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./types/index.d.ts",
  "files": [
    "./lib/*",
    "./types/*"
  ],
  "dependencies": {
    "dcmjs": "~0.52.2",
    "dcmjs-codecs": "~0.0.8"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@stylistic/eslint-plugin": "~5.10.0",
    "@types/b4a": "~1.6.5",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-prettier": "~5.5.7",
    "globals": "~17.13.0",
    "tsc-alias": "~1.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.2"
  }
}
