{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "WebWorker"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "declaration": false,
    "declarationMap": false,
    "removeComments": true,

    "rootDir": "./src",

    /* TS Paths */
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "~/types/*": [
        "./types/*"
      ]
    }
  },
  "include": ["src", "types"]
}
